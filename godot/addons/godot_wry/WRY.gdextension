[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64     = "bin/x86_64-unknown-linux-gnu/libgodot_wry.so"
linux.release.x86_64   = "bin/x86_64-unknown-linux-gnu/libgodot_wry.so"

macos.debug      = "bin/universal-apple-darwin/libgodot_wry.framework"
macos.release    = "bin/universal-apple-darwin/libgodot_wry.framework"

windows.debug.x86_64   = "bin/x86_64-pc-windows-msvc/godot_wry.dll"
windows.release.x86_64 = "bin/x86_64-pc-windows-msvc/godot_wry.dll"

# Android — ARM64 (physical devices) and x86_64 (emulator)
# Paths match cargo-ndk default output layout: -o ../godot/addons/godot_wry/bin/android
# Note: Godot on Android resolves the plain key (android.arm64), not android.debug.arm64
android.arm64          = "bin/android/arm64-v8a/libgodot_wry.so"
android.x86_64         = "bin/android/x86_64/libgodot_wry.so"
android.debug.arm64    = "bin/android/arm64-v8a/libgodot_wry.so"
android.release.arm64  = "bin/android/arm64-v8a/libgodot_wry.so"
android.debug.x86_64   = "bin/android/x86_64/libgodot_wry.so"
android.release.x86_64 = "bin/android/x86_64/libgodot_wry.so"

# iOS — a single .xcframework holds both slices:
#   ios-arm64            (physical devices, aarch64-apple-ios)
#   ios-arm64-simulator  (Apple Silicon Simulator, aarch64-apple-ios-sim)
# Build it with scripts/build_ios.sh. Godot's iOS exporter selects the correct
# slice for the chosen destination (device vs simulator).
# Godot's iOS exporter matches per-architecture, so the keys MUST include the
# arm64 tag (the simulator on Apple Silicon is also arm64; the xcframework holds
# both the ios-arm64 and ios-arm64-simulator slices and Xcode picks per-SDK).
ios.arm64          = "bin/ios/libgodot_wry.xcframework"
ios.debug.arm64    = "bin/ios/libgodot_wry.xcframework"
ios.release.arm64  = "bin/ios/libgodot_wry.xcframework"

[icons]
WebView = "icons/webview.svg"

[dependencies]

macos.debug = {
  "bin/universal-apple-darwin/libgodot_wry.framework" : "Contents/Frameworks"
}
macos.release = {
  "bin/universal-apple-darwin/libgodot_wry.framework" : "Contents/Frameworks"
}

windows.debug.x86_64 = { "bin/x86_64-pc-windows-msvc/godot_wry.dll" : "" }
windows.release.x86_64 = { "bin/x86_64-pc-windows-msvc/godot_wry.dll" : "" }

linux.debug.x86_64 = { "bin/x86_64-unknown-linux-gnu/libgodot_wry.so": "" }
linux.release.x86_64 = { "bin/x86_64-unknown-linux-gnu/libgodot_wry.so": "" }

android.arm64         = { "bin/android/arm64-v8a/libgodot_wry.so": "" }
android.x86_64        = { "bin/android/x86_64/libgodot_wry.so": "" }
android.debug.arm64   = { "bin/android/arm64-v8a/libgodot_wry.so": "" }
android.release.arm64 = { "bin/android/arm64-v8a/libgodot_wry.so": "" }
android.debug.x86_64  = { "bin/android/x86_64/libgodot_wry.so": "" }
android.release.x86_64 = { "bin/android/x86_64/libgodot_wry.so": "" }

ios.arm64         = { "bin/ios/libgodot_wry.xcframework": "" }
ios.debug.arm64   = { "bin/ios/libgodot_wry.xcframework": "" }
ios.release.arm64 = { "bin/ios/libgodot_wry.xcframework": "" }
